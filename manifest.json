{
    "manifest_version": 3,
    "name": "Privacy Scanner",
    "version": "0.1.0",
    "description": "Checks prompts for personal information.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "scanner.js"
            ],
            "run_at": "document_idle"
        }
    ]
}