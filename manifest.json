{
    "manifest_version": 3,
    "name": "Privacy Scanner",
    "version": "0.1.0",
    "description": "Checks prompts for personal information.",
    "host_permissions": [
        "http://127.0.0.1/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*"
            ],
            "js": [
                "scanner.js"
            ],
            "run_at": "document_start"
        }
    ]
}